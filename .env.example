# Backend Configuration
# Comma-separated "user:pass" pairs
FORTE_USERS=user1:pass1,user2:pass2

# Enable debug logging
FORTE_DEBUG=false

# Session TTL in nftables format (e.g. 8h, 30m)
FORTE_SESSION_TTL=8h

# nftables table and set names (must match firewall.nft)
FORTE_NFT_TABLE=forte
FORTE_NFT_SET=allowed_macs

# Set to OpenWRT container name to run nft via docker exec (test rig)
FORTE_ROUTER_CONTAINER=

# Comma-separated admin usernames allowed to manage users
FORTE_ADMINS=admin

# Comma-separated CORS origins
FORTE_CORS_ORIGINS=http://localhost

# Data directory for SQLite database
FORTE_DATA_DIR=/opt/forte/data

# Omada controller integration (optional)
OMADA_CONTROLLER_URL=
OMADA_CONTROLLER_ID=
OMADA_SITE_ID=Default
OMADA_USERNAME=
OMADA_PASSWORD=

# Portal Configuration
VITE_API_URL=
VITE_DEFAULT_REDIRECT=/status?status=success
VITE_APP_NAME=Forte WiFi
VITE_APP_TAGLINE=Sign in to access the network
VITE_POLICY_TEXT=By signing in you agree to the network usage policy.
VITE_TOKEN_KEY=forte_token