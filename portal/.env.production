# ── Backend ───────────────────────────────────────────────────────────────────
# Empty = same origin (nginx proxies /api/* to FastAPI in production)
VITE_API_URL=

# ── Captive portal redirect ───────────────────────────────────────────────────
# Where to send the user after login when no ?redirect= param is present.
# Common values:
#   http://captive.apple.com/hotspot-detect.html  (triggers iOS "Connected" banner)
#   http://connectivitycheck.gstatic.com/generate_204  (Android)
#   http://your-org.com/welcome  (custom landing page)
VITE_DEFAULT_REDIRECT=http://captive.apple.com/hotspot-detect.html

# ── Branding ──────────────────────────────────────────────────────────────────
VITE_APP_NAME=Forte WiFi
VITE_APP_TAGLINE=Sign in to access the network
VITE_POLICY_TEXT=By signing in you agree to the network usage policy.

# ── Session ───────────────────────────────────────────────────────────────────
VITE_TOKEN_KEY=forte_token
